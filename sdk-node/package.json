{
  "name": "simapi-cli",
  "version": "1.1.0",
  "description": "Robotics data validation: URDF profiles, ROS bag and MCAP import, trajectory checks, and CI reports.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "simapi": "bin/simapi.js"
  },
  "files": [
    "dist",
    "bin",
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/robotics.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "robotics",
    "urdf",
    "ros",
    "mcap",
    "validation",
    "physical-ai",
    "simapi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TaxCollector23/simAPI"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@foxglove/rosbag": "^0.4.2",
    "@foxglove/rosmsg": "^5.0.5",
    "@foxglove/rosmsg-serialization": "^2.1.3",
    "@foxglove/rosmsg2-serialization": "^3.1.2",
    "@mcap/core": "^2.4.0",
    "@mcap/support": "^1.1.1",
    "fast-xml-parser": "^5.11.2"
  }
}
